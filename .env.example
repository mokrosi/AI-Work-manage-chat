# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_task_db
POSTGRES_PORT=5433

# Backend runtime database connection (used by Prisma / NestJS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_task_db?schema=public

# Backend server
PORT=3000
NODE_ENV=development

# OpenAI (Agent 1 backend). Set a valid API key to enable the chat endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
