# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_task_db
POSTGRES_PORT=5433

# Backend runtime database connection (used by Prisma / NestJS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_task_db?schema=public

# Backend server
PORT=3000
NODE_ENV=development

# OpenRouter / Gemini (Agent 1 backend). Set a valid API key to enable the chat endpoint.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-1.5-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=AI Task Manager
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_TOOL_STEPS=3

